#!/usr/bin/env sh

# L2: E2E tests || G2: Security (gitleaks + osv-scanner)
# Both must pass; run in parallel (<3min target)

# L2: CLI E2E integration tests (requires build)
(pnpm --filter @nocoo/snaky build && pnpm --filter @nocoo/snaky test:e2e) &
pid_e2e=$!

# Detect a full Xcode developer dir; skip Swift integration tests on
# CommandLineTools-only hosts where xctest cannot dlopen Testing.framework.
# Same gate as .husky/pre-commit.
xcode_dev_dir=$(xcode-select -p 2>/dev/null)
case "$xcode_dev_dir" in
  *Xcode*.app/Contents/Developer) swift_enabled=1 ;;
  *) swift_enabled=0 ;;
esac

if [ "$swift_enabled" = 1 ]; then
  (cd apps/macos && swift test --filter IntegrationTests 2>&1) &
  pid_swift_e2e=$!
else
  echo "pre-push: skipping Swift integration tests — xcode-select -p = ${xcode_dev_dir:-unset}; need a full Xcode.app for swift test (CLT alone cannot dlopen Testing.framework)."
fi

# G2: Security scanning
(
  fail_g2=0

  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks detect --no-banner --source . || fail_g2=1
  else
    echo "⚠ gitleaks not installed, skipping secret scan"
  fi

  if command -v osv-scanner >/dev/null 2>&1; then
    osv-scanner --lockfile=pnpm-lock.yaml || fail_g2=1
  else
    echo "⚠ osv-scanner not installed, skipping vulnerability scan"
  fi

  exit $fail_g2
) &
pid_g2=$!

fail=0
wait $pid_e2e || fail=1
if [ "$swift_enabled" = 1 ]; then
  wait $pid_swift_e2e || fail=1
fi
wait $pid_g2 || fail=1

exit $fail
